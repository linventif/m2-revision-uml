        <ownedOperation xmi:type="uml:Operation" xmi:id="p01_o7" name="Config" visibility="private">
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="p01_o8" name="getInstance" visibility="public" isStatic="true">
