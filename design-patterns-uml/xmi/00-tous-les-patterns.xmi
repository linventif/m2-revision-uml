    <packagedElement xmi:type="uml:Package" xmi:id="p01_pk4" name="01 - Singleton">
      <ownedComment xmi:type="uml:Comment" xmi:id="p01_cm5"><body>But : une seule instance, accessible globalement.</body></ownedComment>
